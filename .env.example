# Frontend: copy the VITE_* entries to frontend/.env.local.
# Leave Clerk unset for a fully public read-only showcase with coming-soon enrollment.
VITE_PUBLIC_API_BASE_URL=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=

# API Worker: configure secrets through Wrangler, never VITE_* variables.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
SECRET_ENCRYPTION_KEY=
INTERNAL_ADMIN_TOKEN=
DEV_AUTH_BYPASS=false
TELEGRAM_BOT_TOKEN=replace-me
DISCORD_DEFAULT_WEBHOOK=https://discord.com/api/webhooks/replace-me
AI_SUMMARY_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_SEVERITY_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_EXPLAIN_MODEL=@cf/meta/llama-3.1-8b-instruct
ALLOWED_ORIGIN=https://pulseflare.pages.dev
